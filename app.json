{
  "expo": {
    "name": "Billing",
    "slug": "billing-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aayashahmad.billingapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/logo.png"
      },
      "package": "com.aayashahmad.billingapp",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "backgroundColor": "#0F172A"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-mark.png",
          "backgroundColor": "#0F172A",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Billing to access your photos so you can attach proof of payment to a bill — a transaction screenshot or a photo of a cheque. Only the image you pick is used.",
          "cameraPermission": "Allow Billing to use the camera so you can photograph a cheque or capture proof of payment for a bill.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Billing to use the camera so you can scan an item's barcode when adding it to a bill.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "83cc75ff-9347-460c-aec1-87a503d0530a"
      }
    },
    "backgroundColor": "#0F172A"
  }
}