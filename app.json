{
  "expo": {
    "name": "Billing",
    "slug": "BillingAppTemp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Billing to access your photos so you can attach a transaction screenshot to a bill.",
          "cameraPermission": "Allow Billing to use the camera so you can capture a transaction screenshot for a bill."
        }
      ]
    ]
  }
}
